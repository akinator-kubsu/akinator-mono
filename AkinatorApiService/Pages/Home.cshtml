@page
@model AkinatorWeb.Pages.HomeModel
@{
    ViewData["Title"] = "Главная";
}

<div class="row">
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-body text-center p-5">
                <h1 class="display-4 mb-3">
                    <i class="fas fa-magic text-primary me-3"></i>
                    Добро пожаловать, @Model.Username!
                </h1>
                <p class="lead text-muted">Готовы сыграть в увлекательную игру с Акинатором?</p>
                
                <div class="mt-4">
                    <a href="/Game" class="btn btn-primary btn-lg me-3">
                        <i class="fas fa-play me-2"></i>Начать новую игру
                    </a>
                    <a href="/Stats" class="btn btn-outline-primary btn-lg">
                        <i class="fas fa-chart-bar me-2"></i>Статистика
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card game-card h-100">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="fas fa-history text-primary me-2"></i>
                    Ваши предыдущие игры
                </h5>
                
                @if (Model.PreviousSessions.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var session in Model.PreviousSessions.Take(5))
                        {
                            <div class="list-group-item px-0 border-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1 text-primary">@session.CharacterName</h6>
                                        <small class="text-muted">
                                            <i class="fas fa-calendar me-1"></i>
                                            @session.StartedAt.ToString("dd.MM.yyyy HH:mm")
                                        </small>
                                    </div>
                                    <div>
                                        @if (session.EndedAt.HasValue)
                                        {
                                            <span class="badge bg-success">Завершена</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">В процессе</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    
                    @if (Model.PreviousSessions.Count > 5)
                    {
                        <div class="text-center mt-3">
                            <small class="text-muted">
                                И ещё @(Model.PreviousSessions.Count - 5) игр...
                            </small>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-gamepad text-muted" style="font-size: 3rem;"></i>
                        <p class="text-muted mt-3">У вас пока нет сыгранных игр</p>
                        <a href="/Game" class="btn btn-outline-primary">
                            Начать первую игру
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
    
    <div class="col-md-6 mb-4">
        <div class="card game-card h-100">
            <div class="card-body">
                <h5 class="card-title">
                    <i class="fas fa-lightbulb text-warning me-2"></i>
                    Как играть
                </h5>
                
                <div class="mt-3">
                    <div class="d-flex align-items-start mb-3">
                        <div class="flex-shrink-0">
                            <span class="badge bg-primary rounded-pill">1</span>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <strong>Загадайте персонажа</strong>
                            <p class="text-muted mb-0">Подумайте о любом реальном или вымышленном персонаже</p>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-start mb-3">
                        <div class="flex-shrink-0">
                            <span class="badge bg-primary rounded-pill">2</span>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <strong>Отвечайте на вопросы</strong>
                            <p class="text-muted mb-0">Акинатор будет задавать вопросы, отвечайте честно</p>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-start mb-3">
                        <div class="flex-shrink-0">
                            <span class="badge bg-primary rounded-pill">3</span>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <strong>Удивляйтесь результату</strong>
                            <p class="text-muted mb-0">Акинатор попытается угадать вашего персонажа!</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
