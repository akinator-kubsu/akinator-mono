@page
@model AkinatorWeb.Pages.LoginModel
@{
    ViewData["Title"] = "Вход в систему";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="card">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="fas fa-magic text-primary" style="font-size: 3rem;"></i>
                    <h2 class="mt-3 mb-1">Добро пожаловать!</h2>
                    <p class="text-muted">Войдите в свой аккаунт</p>
                </div>

                <form method="post">
                    @if (Model.ErrorMessage != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>@Model.ErrorMessage
                        </div>
                    }
                    
                    <div class="mb-3">
                        <label for="Username" class="form-label">
                            <i class="fas fa-user me-2"></i>Имя пользователя
                        </label>
                        <input asp-for="Username" class="form-control" placeholder="Введите имя пользователя" required />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label for="Password" class="form-label">
                            <i class="fas fa-lock me-2"></i>Пароль
                        </label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Введите пароль" required />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-sign-in-alt me-2"></i>Войти
                        </button>
                    </div>
                </form>

                <div class="text-center">
                    <p class="text-muted">Нет аккаунта?</p>
                    <a href="/Register" class="btn btn-outline-primary">
                        <i class="fas fa-user-plus me-2"></i>Зарегистрироваться
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
